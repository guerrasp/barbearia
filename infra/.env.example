# ══════════════════════════════════════════════════
# Variáveis de ambiente da VPS (servidor WhatsApp)
# Copie para .env na mesma pasta do docker-compose.yml
# ══════════════════════════════════════════════════

# Chave de API (mesma configurada na Vercel em WHATSAPP_API_KEY)
WHATSAPP_API_KEY=troque-por-um-segredo-forte

# URL da sua aplicação Next.js (Vercel) para processar mensagens do chatbot
# Exemplos:
#   https://korta.com.br/api/chatbot/incoming
#   https://seu-projeto.vercel.app/api/chatbot/incoming
CHATBOT_WEBHOOK_URL=https://SEU-DOMINIO/api/chatbot/incoming

# Domínio do seu site (para CORS)
# Exemplos:
#   https://korta.com.br
#   https://seu-projeto.vercel.app
CORS_ORIGIN=https://SEU-DOMINIO
