generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== MULTI-TENANT ====================

enum Plan {
  FREE
  PRO
  BUSINESS
}

model Store {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Billing (Stripe)
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  planRenewsAt         DateTime? @map("plan_renews_at")
  trialEndsAt          DateTime? @map("trial_ends_at")

  users        User[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  categories   Category[]
  barbers      Barber[]

  @@map("stores")
}

// ==================== USUÁRIOS ====================

enum UserRole {
  ADMIN
  BARBER
  CUSTOMER
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique @map("supabase_id")
  email      String
  name       String
  role       UserRole @default(BARBER)
  storeId    String   @map("store_id")
  customerId String?  @unique @map("customer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  barber   Barber?

  @@map("users")
}

// ==================== CATEGORIAS DE SERVIÇO ====================

model Category {
  id      String @id @default(uuid())
  name    String
  storeId String @map("store_id")

  store    Store     @relation(fields: [storeId], references: [id])
  services Service[]

  @@unique([name, storeId])
  @@map("categories")
}

// ==================== SERVIÇOS ====================

model Service {
  id              String   @id @default(uuid())
  name            String
  description     String?
  image           String?
  price           Float
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  storeId         String   @map("store_id")
  categoryId      String?  @map("category_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store               Store                @relation(fields: [storeId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  appointmentServices AppointmentService[]

  @@map("services")
}

// ==================== CLIENTES ====================

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  cpf       String?
  address   String?
  city      String?
  state     String?
  zipCode   String?   @map("zip_code")
  birthDate DateTime? @map("birth_date")
  gender    Gender?   @default(NOT_SPECIFIED)
  storeId   String    @map("store_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store        Store         @relation(fields: [storeId], references: [id])
  appointments Appointment[]
  user         User?

  @@map("customers")
}

// ==================== BARBEIROS ====================

model Barber {
  id             String   @id @default(uuid())
  name           String
  bio            String?
  photo          String?
  specialties    String?  // texto livre ou CSV; agrupar em tabela só se virar filtro
  commissionRate Float    @default(0) @map("commission_rate") // 0-100 (%)
  isActive       Boolean  @default(true) @map("is_active")
  storeId        String   @map("store_id")
  userId         String?  @unique @map("user_id") // opcional: barbeiro sem login
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store        Store          @relation(fields: [storeId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])
  workingHours WorkingHours[]
  timeBlocks   TimeBlock[]
  appointments Appointment[]

  @@map("barbers")
}

// Disponibilidade recorrente por dia da semana (0=Dom, 6=Sáb).
// Permite múltiplas faixas no mesmo dia (ex.: manhã e tarde com almoço entre elas).
model WorkingHours {
  id        String @id @default(uuid())
  barberId  String @map("barber_id")
  weekday   Int    // 0..6
  startTime String @map("start_time") // "HH:mm"
  endTime   String @map("end_time")   // "HH:mm"

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, weekday])
  @@map("working_hours")
}

// Bloqueios pontuais: férias, folga, compromisso.
model TimeBlock {
  id        String   @id @default(uuid())
  barberId  String   @map("barber_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startAt])
  @@map("time_blocks")
}

// ==================== AGENDAMENTOS ====================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum AppointmentSource {
  ADMIN   // criado pelo painel
  PUBLIC  // portal público de agendamento
}

model Appointment {
  id              String            @id @default(uuid())
  code            String
  customerId      String            @map("customer_id")
  barberId        String            @map("barber_id")
  storeId         String            @map("store_id")
  startAt         DateTime          @map("start_at")
  endAt           DateTime          @map("end_at") // congelado no momento da marcação (soma das durações)
  status          AppointmentStatus @default(SCHEDULED)
  source          AppointmentSource @default(ADMIN)
  total           Float
  discount        Float             @default(0)
  paymentMethod   PaymentMethod?    @map("payment_method") // definido na conclusão
  paid            Boolean           @default(false)
  paidAt          DateTime?         @map("paid_at")
  notes           String?
  cancelledAt     DateTime?         @map("cancelled_at")
  cancelReason    String?           @map("cancel_reason")
  notifiedReminder Boolean          @default(false) @map("notified_reminder")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer Customer             @relation(fields: [customerId], references: [id])
  barber   Barber               @relation(fields: [barberId], references: [id])
  store    Store                @relation(fields: [storeId], references: [id])
  services AppointmentService[]

  @@unique([storeId, code])
  @@index([storeId, startAt])
  @@index([barberId, startAt])
  @@map("appointments")
}

// Preço e duração são congelados no momento da marcação para não mudar se
// o Service for editado depois.
model AppointmentService {
  id              String @id @default(uuid())
  appointmentId   String @map("appointment_id")
  serviceId       String @map("service_id")
  price           Float
  durationMinutes Int    @map("duration_minutes")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}
