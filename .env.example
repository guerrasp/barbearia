# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env de verdade (já bloqueado no .gitignore).

# ---------- Banco de dados (Supabase / Postgres) ----------
# URL com pooling (pgbouncer). Usada pelo Prisma em runtime.
DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
# URL direta (sem pooling). Usada por migrations/seed.
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"

# ---------- Supabase Auth ----------
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---------- Email (Resend) ----------
RESEND_API_KEY="re_..."
# Enquanto o domínio não for verificado no Resend, use onboarding@resend.dev
EMAIL_FROM="Korta <onboarding@resend.dev>"

# ---------- Cron de lembretes 24h ----------
# Gerar um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="troque-por-um-segredo-forte"

# ---------- Stripe (billing / assinaturas) ----------
# Chaves do dashboard https://dashboard.stripe.com/apikeys
# Em dev use as chaves de teste (sk_test_/pk_test_).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret — vem ao configurar o endpoint em /api/stripe/webhook.
# Em dev local, use `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs (Products → escolha o produto → Prices). Um por plano.
# OBS: o tier "Pioneiro" usa o enum FREE no banco mas é um plano pago
# (R$ 39,90/mês) com 14 dias de trial sem cartão.
STRIPE_PRICE_PIONEIRO="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."

# ---------- Super-admin (painel /super) ----------
# Lista separada por vírgula de emails autorizados a acessar /super
# (visão consolidada de todas as lojas do SaaS).
KORTA_SUPER_ADMINS="seu@email.com"
