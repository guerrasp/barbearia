# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env de verdade (já bloqueado no .gitignore).

# ══════════════════════════════════════════════════
# 1. BANCO DE DADOS (Supabase / Postgres)
# ══════════════════════════════════════════════════
# URL com pooling (pgbouncer). Usada pelo Prisma em runtime.
DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
# URL direta (sem pooling). Usada por migrations/seed.
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"

# ══════════════════════════════════════════════════
# 2. SUPABASE AUTH
# ══════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ══════════════════════════════════════════════════
# 3. EMAIL (Resend)
# ══════════════════════════════════════════════════
RESEND_API_KEY="re_..."
# Enquanto o domínio não for verificado no Resend, use onboarding@resend.dev
EMAIL_FROM="Korta <onboarding@resend.dev>"

# ══════════════════════════════════════════════════
# 4. CRON (lembretes 24h antes)
# ══════════════════════════════════════════════════
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="troque-por-um-segredo-forte"

# ══════════════════════════════════════════════════
# 5. STRIPE (billing / assinaturas da loja)
# ══════════════════════════════════════════════════
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs — um por plano (Products → Prices no dashboard Stripe)
STRIPE_PRICE_PIONEIRO="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_BUSINESS="price_..."
STRIPE_PRICE_KORTA_IA="price_..."

# ══════════════════════════════════════════════════
# 6. WHATSAPP (servidor Baileys na VPS)
# ══════════════════════════════════════════════════
# URL do servidor WhatsApp rodando na VPS (ex: http://178.x.x.x:8080)
WHATSAPP_SERVER_URL="http://SEU-IP-VPS:8080"
# Chave de API compartilhada entre Vercel e VPS (ambos usam a mesma)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_API_KEY="troque-por-um-segredo-forte"

# ══════════════════════════════════════════════════
# 7. CHATBOT IA (Claude Haiku)
# ══════════════════════════════════════════════════
# Chave da API Anthropic — necessária para o chatbot com IA funcionar.
# Sem ela, o chatbot funciona no modo menu numerado (sem IA).
# Criar em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ══════════════════════════════════════════════════
# 8. SUPER-ADMIN
# ══════════════════════════════════════════════════
# Emails que podem acessar /super (visão de todas as lojas)
KORTA_SUPER_ADMINS="seu@email.com"
